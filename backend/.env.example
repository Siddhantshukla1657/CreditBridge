# Example environment configuration for CreditBridge (do NOT commit secrets)
# Copy this file to `backend/.env.dev` for local development and fill values.

# General
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Database (development example uses SQLite; production may use Postgres)
DATABASE_URL=sqlite:///./score_cache.db

# Model and artifacts (paths are relative to repository root)
MODEL_PATH=models/xgb_v1.pkl
FAIRNESS_REPORT_PATH=models/fairness_report.json

# MLflow tracking URI
MLFLOW_TRACKING_URI=./mlruns

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Notes:
# - Keep real credentials out of the repository. Use environment-specific vaults
#   or CI/CD secrets for production deployments.
# - Do NOT commit any file named `*.env*` or `backend/.env.*`.